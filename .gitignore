# Written as an allowlist: everything is ignored, and the repository's own
# files are named back in. The ignored set is the same as the deny-list it
# replaces; the difference is that a new file is ignored until it is named
# here, rather than tracked until someone remembers to exclude it.

/*
!/.gitignore
!/README.md

# the pipeline
!/run_glueplex.py
!/run_msa_baseline.py
!/workflow_scripts/
!/examples/

# PeSTo's entry point only; PeSTo itself is cloned per the README
!/tools/
/tools/*
!/tools/apply_model.py

# environments and the worked example's inputs
!/env_boltz_analysis.yml
!/env_haddock3.yml
!/env_pesto.yml
!/project_config.yaml
!/VAV1_af2.pdb
!/CRBN_pesto.pdb

!/docs/
!/sources/

# never, wherever they appear
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
*.swp
